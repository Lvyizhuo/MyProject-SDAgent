# Lombok 全局配置
# 强制使用稳定的 getter/setter 命名规则，避免 Lombok 1.18.20+ 对 Boolean 包装类型
# （字段名以 is 开头）生成方法名不稳定的问题。
#
# 关键策略：isDefault / isEnabled 等字段已在 ModelProvider / ModelProviderRequest /
# ModelProviderResponse 上通过 @Getter(AccessLevel.NONE) @Setter(AccessLevel.NONE) +
# 显式方法声明 100% 绕开了 Lombok 命名歧义。lombok.config 只做基础配置，不再追加
# 可能与显式方法冲突的规则。

# 关闭 fluent 模式（方法名不带 get 前缀）
lombok.accessors.fluent = false

# 关闭 chain 模式（与 Builder 一起用时更可控）
lombok.accessors.chain = false
