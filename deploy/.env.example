# ===========================================
# 生产环境变量模板（部署到阿里云服务器）
# 用法: cp .env.example .env && vi .env
# ===========================================

# 必填：阿里云 DashScope Key
DASHSCOPE_API_KEY=your-dashscope-api-key

# 可选：联网搜索（不需要可留空）
TAVILY_API_KEY=

# 强烈建议改成高强度随机值
POSTGRES_PASSWORD=replace-with-strong-password
MINIO_USER=minioadmin
MINIO_PASSWORD=replace-with-strong-password

# 强烈建议改成新的 Base64 密钥
# 示例生成: openssl rand -base64 48
APP_JWT_SECRET=replace-with-base64-secret

# 可选但推荐：模型管理 API Key 加密主密钥（不配置时会回退使用 APP_JWT_SECRET）
APP_MODEL_PROVIDER_ENCRYPTION_SECRET=

# 可选：历史加密密钥兼容列表（逗号分隔，用于平滑轮换）
APP_MODEL_PROVIDER_LEGACY_ENCRYPTION_SECRETS=

# 你的正式域名（用于 CORS 放行）
APP_SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=http://mmgg.dpdns.org,https://mmgg.dpdns.org

# 可选：覆盖 Ollama 嵌入服务地址（容器内默认无需改）
APP_EMBEDDING_OLLAMA_BASE_URL=http://ollama:11434

# 可选：Rerank 服务配置（默认使用本地自建 rerank 服务）
APP_RAG_RERANK_PROVIDER=tei
APP_RAG_RERANK_MODEL=bge-reranker-v2-m3
APP_RAG_RERANK_ENDPOINT=http://reranker:80/rerank

# 可选：Rerank 模型 ID（HuggingFace 模型标识）
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3

# 可选：覆盖默认嵌入模型（默认 ollama:bge-m3）
# APP_KNOWLEDGE_EMBEDDING_DEFAULT_MODEL=ollama:bge-m3

# 可选：容器时区（影响日志、数据库时间、CRON 任务）
TZ=Asia/Shanghai

# 必填（使用 mcp profile 时）：高德地图 MCP Server API Key
# mcp-servers.json 已不含明文 key，由 npx 子进程从环境变量读取；旧的明文 key 已泄露，务必使用轮换后的新 key
AMAP_MAPS_API_KEY=

# ===========================================
# 宿主机端口映射（可选，默认值即下方注释值）
# 这些端口只绑定 127.0.0.1，供本机 Nginx（宝塔）反代。
# 与【本地开发】（backend/.env.local 的 DEV_* 端口段）完全隔离，
# 两套方式可在同一台机器上同时运行。
# ===========================================
# POSTGRES_HOST_PORT=5433
# REDIS_HOST_PORT=6379
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# OLLAMA_HOST_PORT=11434
# RERANKER_HOST_PORT=8989
# BACKEND_HOST_PORT=8080
# FRONTEND_HOST_PORT=5173

# 可选：数据卷名前缀（默认 policy-agent，即 policy-agent_postgres_data 等）。
# 从旧版部署（卷名为 deploy_*）升级时，设为 deploy 即可复用旧卷，
# 避免卷改名后看起来像"数据丢了"。
# COMPOSE_VOLUME_PREFIX=policy-agent

# 可选：Flyway 配置（默认会按 V{n}__xxx.sql 自动跑迁移）
# 如需重置数据库，将该值设为 true（仅首次启动生效，**会删除所有数据**）
# FLYWAY_CLEAN_ON_VALIDATION_ERROR=false
# SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

